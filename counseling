<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>1학년 2반 상담 신청 💬</title>
<link href="https://fonts.googleapis.com/css2?family=Gmarket+Sans:wght@300;500;700&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --primary:#0D9488; --glow:#2DD4BF; --accent:#F59E0B;
  --green:#10B981; --red:#EF4444;
  --bg:#0F1512; --surface:#16201C; --surface2:#1C2A25;
  --border:rgba(255,255,255,0.08);
  --text:#EEFFF9; --muted:#7FA096;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Noto Sans KR',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}

/* ── Loading ── */
.loading-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:20px;color:var(--muted);}
.spinner{width:48px;height:48px;border:3px solid rgba(45,212,191,0.2);border-top-color:var(--glow);border-radius:50%;animation:spin 0.9s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ── Login ── */
.login-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;background:radial-gradient(ellipse at 30% 20%,rgba(45,212,191,0.12) 0%,transparent 60%),radial-gradient(ellipse at 70% 80%,rgba(245,158,11,0.08) 0%,transparent 60%),var(--bg);padding:24px;}
.login-card{background:var(--surface);border:1px solid var(--border);border-radius:28px;padding:56px 48px;text-align:center;max-width:400px;width:100%;position:relative;overflow:hidden;}
.login-card::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:200px;height:200px;background:radial-gradient(circle,rgba(45,212,191,0.22) 0%,transparent 70%);pointer-events:none;}
.login-icon{font-size:64px;margin-bottom:20px;}
.login-title{font-family:'Gmarket Sans',sans-serif;font-size:32px;font-weight:700;background:linear-gradient(135deg,#99F6E4,#2DD4BF,#F59E0B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:6px;}
.login-sub{font-size:14px;color:var(--muted);margin-bottom:40px;}
.btn-google{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;padding:16px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:14px;color:var(--text);font-size:15px;font-weight:700;cursor:pointer;transition:all 0.25s;font-family:'Noto Sans KR',sans-serif;}
.btn-google:hover{background:rgba(45,212,191,0.12);border-color:rgba(45,212,191,0.4);transform:translateY(-2px);}
.btn-primary{background:linear-gradient(135deg,var(--primary),#0F766E);color:white;border:none;border-radius:12px;padding:14px 28px;font-size:15px;font-weight:700;cursor:pointer;width:100%;font-family:'Noto Sans KR',sans-serif;transition:all 0.2s;}

/* ── Header ── */
.header{background:rgba(22,32,28,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;}
.header-left{display:flex;align-items:center;gap:14px;}
.header-title{font-family:'Gmarket Sans',sans-serif;font-size:18px;font-weight:700;}
.header-sub{font-size:11px;color:var(--muted);margin-top:2px;}
.header-right{display:flex;align-items:center;gap:10px;}
.user-avatar{width:34px;height:34px;border-radius:50%;border:2px solid rgba(45,212,191,0.5);}
.user-name{font-size:13px;color:var(--muted);}
.badge-teacher{background:linear-gradient(135deg,#F59E0B,#EF4444);color:white;border-radius:8px;padding:3px 10px;font-size:11px;font-weight:900;letter-spacing:0.5px;}
.btn-signout{background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:6px 14px;cursor:pointer;font-size:12px;transition:all 0.2s;font-family:'Noto Sans KR',sans-serif;}
.btn-signout:hover{border-color:var(--red);color:var(--red);}

/* ── Main ── */
.main-wrap{max-width:900px;margin:0 auto;padding:32px 24px 80px;}
.placeholder{background:var(--surface);border:1px dashed var(--border);border-radius:20px;padding:48px 24px;text-align:center;color:var(--muted);margin-top:24px;}
.placeholder .em{font-size:44px;margin-bottom:14px;}
.placeholder .big{font-size:16px;font-weight:700;color:var(--text);margin-bottom:6px;}

/* ── Toast ── */
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(16px);background:rgba(22,36,31,0.95);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.1);color:var(--text);border-radius:14px;padding:12px 24px;font-size:14px;font-weight:700;z-index:300;opacity:0;transition:opacity 0.3s,transform 0.3s;white-space:nowrap;pointer-events:none;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>
<div id="app">
  <div class="loading-screen"><div class="spinner"></div><div style="font-size:14px">로딩 중...</div></div>
</div>
<div id="toast" class="toast"></div>

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
import { getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signOut }
  from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';
import { getFirestore, collection, getDocs, query, where }
  from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

// ── 설정 (미라클 6월과 동일한 Firebase 프로젝트) ──────────────
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyBCZ8zOt6vy85QeuM2tmc1l0SbvLCgI4DI",
  authDomain: "project-7495985191493746478.firebaseapp.com",
  projectId: "project-7495985191493746478",
  storageBucket: "project-7495985191493746478.firebasestorage.app",
  messagingSenderId: "677977589186",
  appId: "1:677977589186:web:4e7eebc230be8dad2c825b"
};

// 교사 이메일 목록 (추가 가능)
const TEACHER_EMAILS = [
  'rapidwing@snu-g.ms.kr',
];

// ── Firebase 초기화 ──────────────────────────────────────────
const fbApp = initializeApp(FIREBASE_CONFIG);
const auth = getAuth(fbApp);
const db = getFirestore(fbApp);
const gProv = new GoogleAuthProvider();

let currentUser = null, userProfile = null;

// ── 유틸 ─────────────────────────────────────────────────────
const isTeacher = u => u?.email && TEACHER_EMAILS.includes(u.email.toLowerCase());
let toastT = null;
function showToast(msg, dur = 2600){
  const el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(() => el.classList.remove('show'), dur);
}
function setApp(h){ document.getElementById('app').innerHTML = h; }

// 미라클 6월에서 쓰는 students 명단을 그대로 재사용
async function findByEmail(email){
  try{
    const s = await getDocs(query(collection(db,'students'), where('email','==',email.toLowerCase())));
    if(s.empty) return null;
    const d = s.docs[0]; return { id:d.id, ...d.data() };
  }catch{ return null; }
}

// ── 공통 헤더 ────────────────────────────────────────────────
function headerHtml(){
  const teacher = isTeacher(currentUser);
  return `
  <div class="header">
    <div class="header-left">
      <div>
        <div class="header-title">💬 상담 시간 신청</div>
        <div class="header-sub">1학년 2반</div>
      </div>
      ${teacher ? '<span class="badge-teacher">교사</span>' : ''}
    </div>
    <div class="header-right">
      ${currentUser.photoURL ? `<img class="user-avatar" src="${currentUser.photoURL}" referrerpolicy="no-referrer">` : ''}
      <span class="user-name">${teacher ? currentUser.displayName : (userProfile?.name || '')}</span>
      <button class="btn-signout" id="btnSO">로그아웃</button>
    </div>
  </div>`;
}

// ── 교사 화면 (2단계에서 시간 설정 기능이 들어갈 자리) ────────
function renderTeacherMain(){
  setApp(`
    ${headerHtml()}
    <div class="main-wrap">
      <div class="placeholder">
        <div class="em">🗓️</div>
        <div class="big">교사용 상담 시간 설정</div>
        여기에 상담 가능한 날짜·시간을 추가하는 화면이 들어갑니다. (2단계)
      </div>
    </div>
  `);
  document.getElementById('btnSO').addEventListener('click', () => signOut(auth));
}

// ── 학생 화면 (3단계에서 선착순 신청 기능이 들어갈 자리) ──────
function renderStudentMain(){
  setApp(`
    ${headerHtml()}
    <div class="main-wrap">
      <div class="placeholder">
        <div class="em">🙋</div>
        <div class="big">${userProfile.name} 학생, 안녕하세요!</div>
        여기에 선생님이 열어둔 상담 시간 중에서 골라 신청하는 화면이 들어갑니다. (3단계)
      </div>
    </div>
  `);
  document.getElementById('btnSO').addEventListener('click', () => signOut(auth));
}

// ── 로그인 화면 ───────────────────────────────────────────────
function renderLogin(){
  setApp(`
    <div class="login-screen"><div class="login-card">
      <div class="login-icon">💬</div>
      <div class="login-title">상담 시간 신청</div>
      <div class="login-sub">1학년 2반 · 선생님과의 상담 시간을 예약해요</div>
      <button class="btn-google" id="bL">
        <svg width="20" height="20" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Google 계정으로 로그인
      </button>
    </div></div>
  `);
  document.getElementById('bL').addEventListener('click', async () => {
    try{ await signInWithPopup(auth, gProv); }
    catch(e){ showToast('로그인 실패: ' + e.message); }
  });
}

// ── 미등록 계정 안내 ──────────────────────────────────────────
function renderUnregistered(email){
  setApp(`
    <div class="login-screen"><div class="login-card">
      <div style="font-size:52px;margin-bottom:16px">⛔</div>
      <div class="login-title" style="font-size:22px">등록되지 않은 계정</div>
      <div class="login-sub" style="margin-bottom:28px">
        <strong>${email}</strong><br>은 등록된 학생 이메일이 아닙니다.<br><br>
        선생님께 이메일 등록을 요청하세요.
      </div>
      <button class="btn-primary" id="bLO">로그아웃</button>
    </div></div>
  `);
  document.getElementById('bLO').addEventListener('click', () => signOut(auth));
}

// ── 로그인 상태 감시 ──────────────────────────────────────────
onAuthStateChanged(auth, async user => {
  if(!user){ currentUser = null; userProfile = null; renderLogin(); return; }
  currentUser = user;

  // 교사
  if(isTeacher(user)){
    userProfile = { role:'teacher' };
    renderTeacherMain(); return;
  }

  // 학생: 미라클 6월과 같은 명단에서 이메일로 찾기
  const student = await findByEmail(user.email);
  if(!student){ renderUnregistered(user.email); return; }

  userProfile = { studentId: student.id, name: student.name, role: 'student' };
  renderStudentMain();
});
</script>
</body>
</html>
