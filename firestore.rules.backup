// ⚠️ 이 파일은 seating.html / students.html 을 만들기 전의 옛 규칙입니다.
// 되돌려야 할 때만 쓰세요. 실제로 배포할 규칙은 firestore.rules 입니다.
//
// 이 규칙의 알려진 문제:
//  1) isTeacher() 가 @snu-g.ms.kr 도메인 전체를 교사로 인정 → 학생도 교사 권한을 가짐
//  2) students 삭제 권한 없음 → 명단 관리 페이지에서 학생 삭제 불가
//  3) counsel_resv 수정 권한 없음 → 출석번호 변경 시 예약 정보 갱신 불가
//  4) seating / seating_seats / seating_mine 규칙 없음 → 자리 선택 페이지 동작 불가

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function isTeacher() {
      return isAuth() && request.auth.token.email.matches('.*@snu-g\\.ms\\.kr');
    }
    function isOwner(studentId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid;
    }

    // 사용자 프로필
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == uid || isTeacher());
    }

    // 학생 목록
    match /students/{studentId} {
      allow read: if isAuth();
      allow create: if isTeacher();
      allow update: if isTeacher() ||
        (isAuth() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) &&
         request.resource.data.uid == request.auth.uid);
    }

    // 학생별 목표/기록
    match /goals/{studentId} {
      allow read: if isAuth();
      allow write: if isOwner(studentId) || isTeacher();
    }

    // 6월 일정표
    match /schedule/{docId} {
      allow read: if isAuth();
      allow write: if isTeacher();
    }
       // 교사인지 확인
    function isT() {
      return request.auth != null
        && request.auth.token.email == 'rapidwing@snu-g.ms.kr';
    }

    // 상담 시간 칸: 누구나 보기 가능, 만들기·삭제는 교사만.
    // 학생은 '빈 칸을 내 것으로'(신청) 또는 '내 칸을 빈 칸으로'(취소)만 가능
    match /counsel_slots/{slotId} {
      allow read: if request.auth != null;
      allow create, delete: if isT();
      allow update: if isT() || (
        request.auth != null
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && (
          (resource.data.taken == false
           && request.resource.data.taken == true
           && getAfter(/databases/$(database)/documents/counsel_resv/$(slotId)).data.uid == request.auth.uid)
          ||
          (resource.data.taken == true
           && request.resource.data.taken == false
           && get(/databases/$(database)/documents/counsel_resv/$(slotId)).data.uid == request.auth.uid
           && !existsAfter(/databases/$(database)/documents/counsel_resv/$(slotId)))
        )
      );
    }

    // 예약자 정보: 교사와 본인만 볼 수 있음 (이름 비공개의 핵심)
    match /counsel_resv/{slotId} {
      allow read: if isT() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isT() || (request.auth != null && request.resource.data.uid == request.auth.uid);
      allow delete: if isT() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
